# ===============================
# Amaze on Work — Environment Config
# ===============================

# LLM (Cerebras)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_OWNER=Rezinix-AI
GITHUB_REPO=shopstack-platform

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_INCIDENTS_CHANNEL_ID=       # Channel ID for #incidents (e.g. C0AL8NG5J79)
SLACK_REPORT_CHANNEL=             # Channel ID for detailed reports
SLACK_INCIDENTS_CHANNEL=incidents # Channel name fallback

# Jira
JIRA_URL=                         # e.g. https://yourorg.atlassian.net
JIRA_EMAIL=                       # Atlassian account email
JIRA_API_TOKEN=                   # From atlassian.net/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=FIX              # Jira project key for new tickets

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=amaze_2026

# App
PORT=8000
MAX_RETRIES=3
RISK_AUTO_MERGE_THRESHOLD=LOW

# Sandbox
SANDBOX_TIMEOUT=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=50000
